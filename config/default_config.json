{
  "app_name": "Agent Speak",
  "version": "1.1.0",
  "general": {
    "enabled": true,
    "autostart": true
  },
  "user_profile": {
    "user_name": "Johon",
    "agent_name": "Jarvis",
    "greeting_mode": "dynamic",
    "custom_startup_text": "Good day Johon, Jarvis is ready at your service.",
    "speak_on_startup": true,
    "greeting_category": "all"
  },
  "audio": {
    "engine": "macos_default",
    "macos_voice": "default",
    "skip_seconds": 5,
    "speak_code_blocks": false,
    "pocket_tts": {
      "enabled": false,
      "voice": "Jarvis_Best",
      "available_voices": [
        "Jarvis_Best",
        "Sayed_Johon_Primary",
        "Jarvis",
        "Male_Peace",
        "Male_News_Caster",
        "Female_Soft_Intimate",
        "Female_Podcast_Host",
        "Male_American_Narrator",
        "Male_Shorts_Creator",
        "Male_Viral_Actor",
        "Female_Confident_Sultry",
        "Male_Energetic_Creator",
        "Male_Social_Media",
        "Male_New",
        "Female_New",
        "Male_Old_Storyteller",
        "Female_Aah",
        "Female_Pro_2",
        "Male_Adam_v2",
        "alba",
        "george",
        "cosette",
        "marius"
      ]
    },
    "volume": 100
  },
  "bgm": {
    "enabled": true,
    "volume": 0.2,
    "random_offset": false,
    "shuffle": true,
    "fade_out_duration": 2.5,
    "fade_in_duration": 0.8,
    "reverb_enabled": true,
    "reverb_preset": "largeHall",
    "reverb_wet_dry": 30.0
  },
  "notch_display": {
    "enabled": true,
    "notch_width": 185,
    "notch_height": 30,
    "follow_cursor_monitor": true,
    "escape_dismiss_enabled": true
  },
  "watched_workspaces": {
    "antigravity": {
      "enabled": true,
      "path": "~/.gemini/antigravity/brain"
    },
    "claude": {
      "enabled": true,
      "path": "~/.claude/projects"
    },
    "opencode": {
      "enabled": true,
      "path": "~/.opencode/sessions"
    },
    "unix_socket": {
      "enabled": true,
      "socket_path": "/tmp/agentspeak.sock"
    }
  },
  "gestures": {
    "enabled": false,
    "camera_device_id": "default",
    "cursor_speed": 1.2,
    "smoothing_factor": 0.85,
    "pinch_threshold": 0.05,
    "tracking_anchor": "wrist",
    "whisper_modifier": "command",
    "hud_enabled": true,
    "toggles": {
      "air_mouse": true,
      "left_click": true,
      "click_and_drag": false,
      "right_click": false,
      "smooth_scroll": false,
      "left_dictation": false,
      "left_return": false,
      "left_shortcuts": false
    }
  },
  "hologram": {
    "enabled": true,
    "theme": "amber",
    "skin": "classicArc",
    "blend_mode": "normal",
    "opacity": 1.0
  },
  "dictation": {
    "mode": "Groq Whisper v3 (Cloud)",
    "groq_api_key": "",
    "model": "whisper-large-v3",
    "custom_model": "",
    "custom_base_url": "",
    "language": "",
    "auto_submit_return": false
  }
}