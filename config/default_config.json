{
  "app_name": "Agent Speak",
  "version": "1.0.0",
  "general": {
    "enabled": true,
    "autostart": true
  },
  "audio": {
    "engine": "macos_default",
    "macos_voice": "default",
    "skip_seconds": 5,
    "pocket_tts": {
      "enabled": false,
      "voice": "Jarvis",
      "available_voices": [
        "Jarvis",
        "Sayed_Johon_Primary",
        "alba",
        "george"
      ]
    },
    "volume": 1.0
  },
  "bgm": {
    "enabled": true,
    "volume": 0.20,
    "random_offset": false,
    "shuffle": true,
    "fade_out_duration": 2.5,
    "fade_in_duration": 0.8,
    "reverb_enabled": true,
    "reverb_preset": "largeHall",
    "reverb_wet_dry": 30.0
  },
  "notch_display": {
    "enabled": true,
    "notch_width": 185,
    "notch_height": 30,
    "follow_cursor_monitor": true,
    "escape_dismiss_enabled": true
  },
  "watched_workspaces": {
    "antigravity": {
      "enabled": true,
      "path": "~/.gemini/antigravity/brain"
    },
    "claude": {
      "enabled": true,
      "path": "~/.claude/projects"
    },
    "opencode": {
      "enabled": true,
      "path": "~/.opencode/sessions"
    },
    "unix_socket": {
      "enabled": true,
      "socket_path": "/tmp/agentspeak.sock"
    }
  }
}
